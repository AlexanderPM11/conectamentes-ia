# MySQL
MYSQL_DATABASE=conectamente
MYSQL_USER=conectamente
MYSQL_PASSWORD=conectamente
MYSQL_ROOT_PASSWORD=change-this-root-password
# Solo necesario si ejecutas MySQL fuera de Docker; Dokploy lo mantiene interno.
MYSQL_PORT=3306

# Backend
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__Default=server=mysql;port=3306;database=${MYSQL_DATABASE};user=${MYSQL_USER};password=${MYSQL_PASSWORD}
Jwt__Key=replace-with-a-long-random-production-secret
Jwt__Issuer=ConectaMentes.Api
Jwt__Audience=ConectaMentes.Frontend
# En producción: https://app.tu-dominio.com
CORS_ORIGIN=http://localhost:3000
DisableHttpsRedirection=true

# Frontend build-time configuration
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
Google__ClientId=your-google-oauth-client-id.apps.googleusercontent.com
Admin__Email=admin@tu-dominio.com
Admin__Password=cambia-esta-clave-por-una-de-12-caracteres
Admin__DisplayName=Superadministrador
ChatUploads__Path=/app/data/chat-uploads
ChatUploads__MaxBytes=10485760
FRONTEND_PORT=3000
