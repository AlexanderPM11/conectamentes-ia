# MySQL
MYSQL_DATABASE=conectamente
MYSQL_USER=conectamente
MYSQL_PASSWORD=conectamente
MYSQL_ROOT_PASSWORD=change-this-root-password
# Solo necesario si ejecutas MySQL fuera de Docker; Dokploy lo mantiene interno.
MYSQL_PORT=3306

# Backend
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__Default=server=mysql;port=3306;database=${MYSQL_DATABASE};user=${MYSQL_USER};password=${MYSQL_PASSWORD}
Jwt__Key=replace-with-a-long-random-production-secret
Jwt__Issuer=ConectaMentes.Api
Jwt__Audience=ConectaMentes.Frontend
# En producción: https://app.tu-dominio.com
CORS_ORIGIN=http://localhost:3000
DisableHttpsRedirection=true

# Frontend build-time configuration
# Vacío: el frontend usa el proxy interno /api y /hubs del mismo dominio.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JEV_API_KEY=
JEV_ENDPOINT=https://www.jevai.org/api/v1/decisions/model-route
JEV_TIMEOUT_SECONDS=4
JEV_PRIORITIES=quality,context,latency,cost
JEV_CONSTRAINTS=Use only a configured candidate.,Keep the selected model compatible with the configured text provider.
JEV_STAKES=medium
TUTOR_FREE_MESSAGE_LIMIT=15
TUTOR_PREMIUM_MESSAGE_LIMIT=2000
TUTOR_USAGE_PERIOD_DAYS=30
TUTOR_TRIAL_DAYS=7
TUTOR_TRIAL_PROVIDER=trial
TUTOR_AI_TIMEOUT_SECONDS=30
TUTOR_AI_TEMPERATURE=0.35
TUTOR_AI_MAX_TOKENS=700
TUTOR_SAFETY_TERMS=examen,copiar,hazme la tarea,resuelve todo
TUTOR_AI_FALLBACK_MESSAGE=Vamos a trabajar **{subject}**. Primero, dime qué parte ya entiendes y cuál te confunde. Después te daré una pista, un ejemplo y una pregunta corta para comprobar tu comprensión.
AI_ROUTER_LONG_TASK_CHARS=900
AI_ROUTER_COMPLEXITY_TERMS=demuestra,compara,deriva
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_FAST_DESCRIPTION=Fast general tutor for short explanations, simple practice and low latency.
AI_MODEL_FAST_COST=low
AI_MODEL_FAST_LATENCY=low
AI_MODEL_FAST_CONTEXT=32k
AI_MODEL_REASONING=gpt-4o
AI_MODEL_REASONING_DESCRIPTION=Stronger reasoning tutor for difficult university concepts and multi-step problems.
AI_MODEL_REASONING_COST=medium
AI_MODEL_REASONING_LATENCY=medium
AI_MODEL_REASONING_CONTEXT=128k
AI_MODEL_LONG_CONTEXT=
AI_MODEL_LONG_CONTEXT_DESCRIPTION=Long-context tutor for extended study material and conversation history.
AI_MODEL_LONG_CONTEXT_COST=high
AI_MODEL_LONG_CONTEXT_LATENCY=medium
AI_MODEL_LONG_CONTEXT_WINDOW=200k
Google__ClientId=your-google-oauth-client-id.apps.googleusercontent.com
# Web Push: genera el par una sola vez y conserva la clave privada únicamente en el servidor.
WebPush__PublicKey=replace-with-vapid-public-key
WebPush__PrivateKey=replace-with-vapid-private-key
WebPush__Subject=mailto:admin@tu-dominio.com
Admin__Email=admin@tu-dominio.com
Admin__Password=cambia-esta-clave-por-una-de-12-caracteres
Admin__DisplayName=Superadministrador
ChatUploads__Path=/app/data/chat-uploads
ChatUploads__MaxBytes=10485760
ProfileAvatars__Path=/app/data/profile-avatars
FRONTEND_PORT=3000
